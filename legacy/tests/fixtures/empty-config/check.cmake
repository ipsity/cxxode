if(NOT DEFINED SETTINGS_FILE)
    set(SETTINGS_FILE config.txt)
endif()
if(RECORD_ATTEMPT)
    file(APPEND "${CMAKE_CURRENT_LIST_DIR}/observed-runs.txt" "tested\n")
endif()
if(HOLD_TEST)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 3)
    file(WRITE "${CMAKE_CURRENT_LIST_DIR}/observed-completion.txt" "finished\n")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/sample.conf" input)
file(READ "${CMAKE_CURRENT_LIST_DIR}/${SETTINGS_FILE}" settings)
if(NOT input STREQUAL "" OR NOT settings MATCHES "empty_config = allow")
    message(FATAL_ERROR "empty configuration was rejected")
endif()
if(FORCE_FAILURE)
    message(FATAL_ERROR "a separate assertion still fails")
endif()
