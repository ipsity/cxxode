diff --git a/src/core/session.cpp b/src/core/session.cpp
index 871a4b0..033ae82 100644
--- a/src/core/session.cpp
+++ b/src/core/session.cpp
@@ -1,0 +2,4 @@
+#ifdef LAY_P22_EXPERIMENT
+#include "core/benchmark.hpp"
+#include <future>
+#endif
@@ -168,0 +173,60 @@ bool collect_supplement(Session& session, const SessionJournal& journal) {
+#ifdef LAY_P22_EXPERIMENT
+bool experiment_pair_reads(Session& session, const ExecuteTool& execute, const StopRequested& stop,
+                           std::size_t limit, const AuthorizeTool& authorize, const SessionJournal& journal) {
+    const auto* workers = std::getenv("LAY_P22_READ_WORKERS");
+    auto& tools = session.rounds.back().tools;
+    if (!workers || std::string_view(workers) != "2" || !journal.save || journal.accept_supplement ||
+        !authorize || tools.size() < 2 || tools.size() > limit || stop() ||
+        !std::ranges::all_of(tools, [&](const ToolRecord& item) {
+            return !item.dispatched && item.result.status == ToolStatus::pending &&
+                (item.call.name == "read" || item.call.name == "search") && authorize(item.call).empty();
+        })) return false;
+
+    const auto dispatch = [&](ToolRecord& record) {
+        record.dispatched = true;
+        ++session.dispatches;
+        try {
+            save(journal, session, "dispatch");
+        } catch (...) {
+            record.dispatched = false;
+            --session.dispatches;
+            throw;
+        }
+    };
+    const auto commit = [&](ToolRecord& record, ToolResult result) {
+        record.result = std::move(result);
+        if (record.result.status != ToolStatus::ok) {
+            record.result.status = ToolStatus::failed;
+            pause_on_repeated_file_failure(session, record);
+        }
+        save(journal, session, "result");
+    };
+    bool failed = false;
+    for (std::size_t i = 0; i < tools.size();) {
+        if (stop()) session.stop = SessionStop::cancelled;
+        if (failed || session.stop != SessionStop::end_turn) {
+            auto& pending = tools[i++];
+            if (pending.result.status != ToolStatus::pending) continue;
+            pending.result = {ToolStatus::skipped, failed ? "prior_tool_failed" : std::string(name(session.stop))};
+            save(journal, session, "result");
+            continue;
+        }
+        auto& first = tools[i++];
+        dispatch(first);
+        auto observation = std::async(std::launch::async, [&] { return execute(first.call); });
+        if (i < tools.size() && !stop()) {
+            auto& second = tools[i++];
+            dispatch(second);
+            auto second_result = execute(second.call);
+            commit(first, observation.get());
+            commit(second, std::move(second_result));
+            failed = first.result.status != ToolStatus::ok || second.result.status != ToolStatus::ok;
+        } else {
+            commit(first, observation.get());
+            failed = first.result.status != ToolStatus::ok;
+        }
+    }
+    return true;
+}
+#endif
+
